default_platform(:ios)

platform :ios do
  desc "Bump build number, build, and push to TestFlight"
  lane :beta do
    # Ensure certificates & profiles are valid (Match uses App Store Connect API)
    sync_code_signing(type: "appstore", readonly: true)

    # Increment build number from App Store Connect
    increment_build_number(
      build_number: latest_testflight_build_number + 1
    )

    # Build the Flutter app in release mode
    sh("flutter build ios --release --no-codesign")

    # Archive & sign
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store"
    )

    # Upload to TestFlight
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      changelog: "Automated release from CI"
    )

    # Tag the Git commit
    add_git_tag(tag: "ios-beta-#{get_build_number}")
    push_git_tags
  end
end
