# Carnama Labs — root gitignore (CI-2 secrets hygiene, W1.3)
# Secrets — never commit. Example/template variants ARE tracked.
*.env
!.env.example
*.keystore
*.jks
key.properties
**/failures/

# Generated tool state — untracked per orchestrator decision (CI-3 session, 2026-09-02).
# These were accidentally committed in 45b3b55; Flutter/Dart regenerates them on
# every lutter pub get / build, so version-controlling them only creates
# permanent phantom diffs on every machine. Never re-add.
.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies
**/generated_plugin_registrant.cc
**/generated_plugin_registrant.h
**/generated_plugins.cmake
**/GeneratedPluginRegistrant.swift
emulator_err.log
emulator_out.log

# FIX-B10 (AUD4-C12-05) Litter and artifact-class hygiene rules
coverage/
**/coverage/
node_modules/
**/node_modules/
*.info
/perf2_*
/potato*.md
/*.iml
# NOTE: `.idea/modules.xml` is NOT ignored on purpose — this repo deliberately tracks
# `.idea/.name` + `.idea/runConfigurations/**` (the melos bootstrap/run/test tasks) as
# shared project state, and modules.xml is the index that points at them. Ignoring it
# would silently strand tracked IDE config. Evidence: `git ls-files '.idea/*'`.
/*_out.txt
/*_err.txt
/**/test_out.txt
/**/test_err.txt
/analytics_calls.txt
/checks_usage.txt
/config_test_refs.txt
/dead_tests.txt
/screen_matrix.csv
/skip_findings.txt
/test_assert_gaps*.csv
/test_assert_gaps*.txt
/_
/_screen_matrix.ps1
tool_audit/*/scratch/
*.log
!tool_audit/*/receipts/*.log
/tool_archive/*.tar.gz
!/tool_archive/perf2_litter.tar.gz
!/tool_archive/perf2_judge_litter.tar.gz
!/tool_archive/aud4_scratch.tar.gz
# p26 D-P26-2(c): machine-local Cline skill cache - never shared, never versioned
/.agents/
backups/

# P2-1a proof harness runtime state (ports/pid; regenerated by `node tool/shell_proof.mjs up`)
.shell-proof.json
core_app/.shell-firebase.json
